    "xbox": "A",
    "ps": "Cross",
    "switch": "A",
    "kbm": "Enter"
   },
   "interact": {
    "xbox": "X",
    "ps": "Square",
    "switch": "Y",
    "kbm": "E"
   }
  },
  "hold_to_confirm": []
 },
