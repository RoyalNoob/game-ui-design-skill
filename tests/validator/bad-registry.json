   },
   "hud.bottom-right.ammo": {
    "component": "",
    "tags": [
     "#p1",
     "#readout",
     "#loc"
    ],
    "visibility": "peek"
   },
   "hud.center.interact-prompt": {
    "component": "@prompt",
    "action": "jump",
    "tags": [
